[Unit]
Description=Laravel Queue Worker (token booking / face recognition jobs)
After=network.target mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/backend
ExecStart=/usr/bin/php artisan queue:work --queue=default --tries=3 --max-time=3600 --sleep=1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
